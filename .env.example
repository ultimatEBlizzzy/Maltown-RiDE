# ============================================================
# MALTown RiDE — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# All secrets are read server-side only.
# ============================================================

# --- Database -------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/maltown_ride

# --- Auth -----------------------------------------------------
# REQUIRED in production: long random string.
JWT_SECRET=
# Set a separate 32+ character secret only while creating the first production admin.
ADMIN_BOOTSTRAP_TOKEN=

# --- Fare engine (South African rand; editable pilot rates) ----
FARE_BASE=15
FARE_PER_KM=6
FARE_PER_MIN=0.8
FARE_BOOKING_FEE=5
FARE_MIN=25

# --- Driver matching -------------------------------------------
MATCH_RADIUS_KM=15
MATCH_MAX_CANDIDATES=10
MATCH_REQUEST_TTL_SEC=45
DRIVER_AVG_SPEED_KMH=26
DRIVER_SHARE=0.8

# --- Routing ----------------------------------------------------
# Leave empty to use the built-in mock development provider.
# Point at an OSRM-compatible server for real road routing:
OSRM_BASE_URL=
ROUTING_ROAD_FACTOR=1.3

# --- Payments (PayFast — real integration pending credentials) --
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# --- SMS / OTP (Twilio — real integration pending credentials) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Maps (optional overrides) -----------------------------------
MAP_TILE_URL=
MAP_ATTRIBUTION=
MAPS_API_KEY=

# --- Redis (optional — hot driver-location cache / pub-sub) ------
REDIS_URL=
